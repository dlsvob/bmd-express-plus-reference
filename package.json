{
  "name": "bmdx_plus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"npm:dev:vite-server\" \"npm:dev:electron-start\"",
    "dev:vite-server": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite",
    "dev:electron-start": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:electron && npm run build:vite",
    "build:vite": "vite build --config vite.config.ts",
    "build:electron": "npx tsc --build",
    "build:singlefile": "cross-env BUILD_TARGET=singlefile vite build --config vite.config.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "package": "npm run build && npx electron-builder",
    "package:mac": "npm run build && npx electron-builder --mac",
    "package:win:portable": "npm run build && npx electron-builder --win portable --x64 -c.portable.artifactName=\"\\${productName} Portable \\${version}.\\${ext}\"",
    "package:win:user": "npm run build && npx electron-builder --win nsis --x64 -c.nsis.perMachine=false -c.nsis.oneClick=false -c.nsis.allowToChangeInstallationDirectory=true -c.nsis.artifactName=\"\\${productName} User Setup \\${version}.\\${ext}\"",
    "package:win:machine": "npm run build && npx electron-builder --win nsis --x64 -c.nsis.perMachine=true -c.nsis.oneClick=false -c.nsis.allowToChangeInstallationDirectory=true -c.nsis.artifactName=\"\\${productName} System Setup \\${version}.\\${ext}\"",
    "package:all": "npm run build && npm run _package:all:post-build",
    "_package:all:post-build": "echo '--- Building Mac ---' && npx electron-builder --mac && echo '--- Building Win Portable ---' && npx electron-builder --win portable --x64 -c.portable.artifactName=\"${productName} Portable ${version}\" && echo '--- Building Win User ---' && npx electron-builder --win nsis --x64 -c.nsis.perMachine=false -c.nsis.oneClick=false -c.nsis.allowToChangeInstallationDirectory=true -c.nsis.artifactName=\"${productName} User Setup ${version}\" && echo '--- Building Win Machine ---' && npx electron-builder --win nsis --x64 --arm64 -c.nsis.perMachine=true -c.nsis.oneClick=false -c.nsis.allowToChangeInstallationDirectory=true -c.nsis.artifactName=\"${productName} System Setup ${version}\" && echo '--- Building Linux ---' && npx electron-builder --linux",
    "make:mac": "npm run package:mac",
    "make:win:user": "npm run package:win:user",
    "make:win:machine": "npm run package:win:machine",
    "make:win:portable": "npm run package:win:portable",
    "make:linux": "npm run build && npx electron-builder --linux"
  },
  "build": {
    "appId": "com.sciome.bmdxplus",
    "productName": "BMDx Plus",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "afterPack": "./scripts/afterPackHook.js",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "appImage": {}
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@bokeh/bokehjs": "3.7.1",
    "@reduxjs/toolkit": "^2.6.1",
    "antd": "5.24.5",
    "buffer": "6.0.3",
    "cytoscape": "3.31.2",
    "dexie": "^4.0.11",
    "electron-squirrel-startup": "^1.0.1",
    "events": "3.3.0",
    "idb": "8.0.2",
    "lodash.debounce": "4.0.8",
    "oboe": "^2.1.7",
    "plotly.js": "3.0.1",
    "pyodide": "0.23.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.23.1",
    "stream-browserify": "3.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/electron": "1.4.38",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/eslint-scope": "3.7.7",
    "@types/geojson-vt": "3.2.5",
    "@types/less": "3.0.8",
    "@types/lodash.debounce": "4.0.9",
    "@types/mapbox__point-geometry": "0.1.4",
    "@types/mapbox__vector-tile": "1.3.4",
    "@types/node": "22.14.0",
    "@types/oboe": "^2.1.4",
    "@types/pbf": "3.0.5",
    "@types/plotly.js": "2.35.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "2.6.3",
    "@types/sass": "1.43.1",
    "@types/stylus": "0.48.43",
    "@types/supercluster": "7.1.3",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@typescript-eslint/parser": "8.29.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "csv-parse": "5.6.0",
    "electron": "31.0.1",
    "electron-builder": "24.13.3",
    "eslint": "9.24.0",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "^15.15.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.24.1",
    "vite": "6.3.2",
    "vite-plugin-singlefile": "^2.0.1",
    "wait-on": "7.2.0"
  }
}
