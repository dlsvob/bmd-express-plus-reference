// tsconfig.preload.json
{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "outDir": "./dist-electron",
        "rootDir": "./electron",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "tsBuildInfoFile": "./dist-electron/.tsbuildinfo.preload",
        "sourceMap": true,
        "types": [
            "node"
        ] // Usually only needs Node types
    },
    "include": [
        "electron/preload.ts"
    ], // Only include preload.ts
    "exclude": [
        "node_modules",
        "dist",
        "electron/main.ts"
    ]
}