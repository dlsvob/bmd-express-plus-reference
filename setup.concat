import React from 'react';
// Import HashRouter instead of BrowserRouter
import { HashRouter as Router, Routes, Route } from 'react-router-dom';
import WelcomePage from './components/WelcomePage';
import InitializeProject from './components/InitializeProject';
import AnalyzeProject from './components/AnalyzeProject';
import { PyodideProvider } from './contexts/PyodideProvider';

const App: React.FC = () => {
  return (
    <PyodideProvider>
      {/* Use HashRouter */}
      <Router>
        <Routes>
          {/* Routes remain the same */}
          <Route path="/" element={<WelcomePage />} />
          <Route path="/initialize" element={<InitializeProject />} />
          <Route path="/analyze" element={<AnalyzeProject />} />
        </Routes>
      </Router>
    </PyodideProvider>
  );
};

export default App;// index.tsx
import React from 'react';
import './index.css';
import { createRoot } from 'react-dom/client';
import { Provider } from 'react-redux';
import App from './App';
import { store } from './store/store';
import '@ant-design/v5-patch-for-react-19';

const container = document.getElementById('root');
if (container) {
  const root = createRoot(container);
  root.render(
    <React.StrictMode>
      <Provider store={store}>
        <App />
      </Provider>
    </React.StrictMode>
  );
}
<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <!-- <link rel="icon" href="%PUBLIC_URL%/vite.svg" /> -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- In your index.html, somewhere in <head> or <body> but before main.js/ts is loaded -->
  <script src="https://cdn.jsdelivr.net/pyodide/v0.23.4/full/pyodide.js"></script>
  <title>UMAP Canvas</title>
</head>
<body>
  <div id="root"></div>
  <script type="module" src="/src/index.tsx"></script>
</body>

</html>