// tsconfig.main.json
{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "./dist-electron",
        "rootDir": "./electron",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "tsBuildInfoFile": "./dist-electron/.tsbuildinfo.main",
        "sourceMap": true,
        "types": ["node", "electron"],
            "typeRoots": [
                "./node_modules/@types",
                "./src/types"
            ]
    },
"include": [
    "electron/main.ts",
    "src/types/**/*.d.ts"
],
"exclude": [
    "node_modules",
    "dist",
    "electron/preload.ts"
]
}